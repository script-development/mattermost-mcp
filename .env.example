# Copy to .env and fill in. .env is gitignored — never commit a real token.
#
# Base URL of your Mattermost server (no trailing /api/v4).
MM_URL=https://chat.script.nl
#
# A Mattermost Personal Access Token. Create one at:
#   Profile picture → Security → Personal Access Tokens → Create Token
# (requires the admin setting "Enable Personal Access Tokens"). The MCP acts as
# whoever owns this token, so each user supplies their own.
MM_TOKEN=your-personal-access-token-here
